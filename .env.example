# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env` to version control.

# OpenAI API key — used by the orchestrator (Brain) for plan generation.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional: root directory for mission sandboxes.
# Defaults to ~/.ai-empire/missions on Unix and %USERPROFILE%\.ai-empire\missions on Windows.
# MISSIONS_ROOT=
